# copy to .env (never commit .env)
DOMAIN=localhost            # on EC2: <elastic-ip-with-dashes>.sslip.io  (HTTPS is required for camera + GPS)
STORAGE=local               # local | s3
S3_BUCKET=
AWS_REGION=ap-south-1
TRIAGE_MODE=manual          # manual | bedrock
BEDROCK_MODEL_ID=           # read from your account (aws bedrock list-inference-profiles); do not guess
CAPTURE_SECRET=             # long random string (openssl rand -hex 24); signs capture tokens
REQUIRE_LIVE_CAPTURE=0      # 1: report photos without a fresh in-app capture token are held for review
