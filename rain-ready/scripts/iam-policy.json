{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PhotosAndBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET/*"
    },
    {
      "Sid": "TriageWithBedrock",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:Converse"],
      "Resource": "*"
    }
  ]
}
